# Frontend (copy to client/.env)
VITE_GAME_NAME=APPLE WORM ADVENTURE
VITE_API_URL=http://localhost:5000/api

# Backend (copy to server/.env)
GAME_NAME=APPLE WORM ADVENTURE
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/apple-worm-adventure
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
# Development-only simulated ad provider. Must remain false in production.
ALLOW_DEMO_ADS=true
